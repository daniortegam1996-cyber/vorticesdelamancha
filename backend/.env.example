# ============================================
# Vórtices de la Mancha - Environment Variables
# ============================================
# Copia este archivo como .env y rellena con tus datos reales

# ============================================
# Database Configuration
# ============================================
MONGO_URL="mongodb://localhost:27017"
DB_NAME="vortices_mancha"

# ============================================
# CORS Configuration
# ============================================
# En producción, especifica tu dominio: https://vorticesdelamancha.com
CORS_ORIGINS="*"

# ============================================
# SMTP Configuration for Email
# ============================================
# Servidor SMTP de tu proveedor de correo
# Ejemplos:
#   - Ionos/1&1: smtp.ionos.es (puerto 587)
#   - Hostalia: smtp.hostalia.com (puerto 587)
#   - Gmail: smtp.gmail.com (puerto 587)
#   - Outlook/Hotmail: smtp.office365.com (puerto 587)
#   - Zoho: smtp.zoho.eu (puerto 587)

SMTP_SERVER="smtp.tuproveedor.com"
SMTP_PORT=587

# Credenciales de tu cuenta de correo
SMTP_USERNAME="informacion@vorticesdelamancha.com"
SMTP_PASSWORD="tu_password_segura"

# Configuración del remitente
SMTP_FROM_EMAIL="informacion@vorticesdelamancha.com"
SMTP_FROM_NAME="Vórtices de la Mancha"

# Email donde llegarán los mensajes (normalmente el mismo)
SMTP_TO_EMAIL="informacion@vorticesdelamancha.com"

# Seguridad SMTP (normalmente STARTTLS=True, SSL_TLS=False para puerto 587)
SMTP_STARTTLS=True
SMTP_SSL_TLS=False

# ============================================
# Debug Mode
# ============================================
# En producción cambiar a false
DEBUG=false
